    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SQLConnection": "Data Source=AMRESH;Initial Catalog=LoanManagementSystem;trusted_connection=true;TrustServerCertificate=True"
  },
  "SecretKey": "AmreshChadraSecretKeyJWTAmreshChadraSecretKeyJWT",

  "Serilog": {
